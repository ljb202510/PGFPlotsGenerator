# ============================================================
# PGFPlotsGenerator 后端环境变量模板
# 使用方法：复制为 .env 并填入真实值
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# ⚠️ 安全：.env 含 SMTP 授权码与 AI API Key，务必加入 .gitignore，
#        切勿提交到仓库 / 发送给他人。
# 说明：backend/db.js 会读取下方 DB_* 变量；未设置时回退本地开发
#       默认值 localhost/root/000/X，服务器部署请务必在此改为真实凭据。
# ============================================================

# ---- 服务配置（app.js 读取）----
# 后端监听端口，默认 3000
PORT=3000
NODE_ENV=development

# ---- JWT 密钥（middleware/auth.js、routes/auth.js 读取）----
# app.js 启动时会校验该变量，缺失直接退出；生产环境请改为足够随机的长字符串
JWT_SECRET=your-super-secret-jwt-key-change-me

# ---- 数据库配置（backend/db.js 读取，缺省回退本地默认值）----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=000
DB_NAME=X

# ---- SMTP 邮件服务（services/verificationService.js 读取）----
# 用于发送注册/改邮箱验证码，示例为 QQ 邮箱
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-email@qq.com
# QQ 邮箱需在「设置-账户」中开启 SMTP 并生成授权码（非登录密码）
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM="系统管理员 <your-qq-email@qq.com>"

# ---- DeepSeek 模型（routes/chat.js DeepSeek 分支读取）----
# 对应模型 deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ---- Qwen3.5（routes/chat.js Qwen 分支读取，湖大超算 NSCC MaaS）----
# OpenAI 兼容接口，SDK baseURL 指向该地址
NSCC_API_KEY=your-nscc-api-key
NSCC_API_URL=https://maas.nscc-cs.cn/external/api/v1

# ---- 其他（备用）----
DATABASE_URL=your-database-url
